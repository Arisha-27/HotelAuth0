# ═══════════════════════════════════════════
# Aegis Hospitality OS - Environment Configuration
# ═══════════════════════════════════════════

# ── Auth0 (Phase 2) ──
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# ── Gmail API (Step 56) ──
# Leave blank to use mock mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=aegis-os@aegis-hospitality.com

# ── Notion API (Step 57) ──
# Leave blank to use mock mode
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── Twilio SMS (Step 58) ──
# Leave blank to use mock mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# ── Claude / Anthropic (Phase 4) ──
ANTHROPIC_API_KEY=
